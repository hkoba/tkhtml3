# Test script for Tkhtml
#
# Tests for the "Tier 1 modern baseline pack" (see agent_docs/roadmap.md):
#
#     modern-1.*  HTML5 vocabulary: tags in tokenlist.txt + html.css rules
#                 (previously unknown tags were silently dropped by the
#                 parser), implicit </p> before structural elements, the
#                 global [hidden] attribute.
#
#     modern-2.*  CSS3 selectors: :root, :empty, :only-child,
#                 :first-of-type/:last-of-type/:nth-of-type(),
#                 :nth-last-child(), :not(<simple selector>).
#
#     modern-3.*  The rem unit (root-element-relative lengths).
#
#     modern-4.*  The currentColor keyword.
#
#     modern-5.*  white-space: pre-wrap and pre-line. Expectations are
#                 expressed as multiples of a one-line reference height
#                 (and width inequalities) so they do not depend on the
#                 fonts installed on the machine.
#
#     modern-6.*  word-spacing (letter-spacing is still unrendered -
#                 see the audit note in agent_docs/roadmap.md).
#
#     modern-7.*  CSS custom properties ("--x") and var().
#
#     modern-8.*  Conditional @media queries (min/max-width/height),
#                 including restyle-on-resize.
#
#     modern-9.*  Viewport units vw/vh/vmin/vmax.
#
#     modern-10.* calc() stage 1: same-unit folding, absolute-unit
#                 folding, * and / by numbers, nesting. Percentages and
#                 mixed relative units invalidate the declaration (the
#                 cascade falls back).
#
#     modern-11.* Flexbox stage A (single-line): grow/shrink/basis
#                 resolution, justify-content, gap, column direction,
#                 auto margins, align-items, order, max-width freezing,
#                 stretch, inline-flex shrink-to-fit, the text-only
#                 fallback. All geometry uses fixed pixel sizes, so
#                 the assertions are font-independent.
#
#     modern-12.* Flexbox stage B (multi-line): flex-wrap partitioning,
#                 align-content (stretch/center/space-between),
#                 wrap-reverse (lines stack from the cross-end),
#                 two-axis gap, column wrapping, baseline alignment,
#                 the flex-flow shorthand.
#
#     modern-13.* calc() stage 2: percentage + absolute-length mixes
#                 resolved against the containing block at layout
#                 time; pure-percent arithmetic folds to a plain
#                 percentage; % + relative units still fall back.
#
#     modern-14.* Options-menu items (roadmap): the 'outline'
#                 shorthand (previously dead-stored) + :focus;
#                 box-shadow (single outer shadow, sharp);
#                 background-size (cover/contain/lengths/%).
#
#     modern-15.* :is() and :where(): OR-matching over a list of
#                 simple selectors, :is() = max argument specificity,
#                 :where() = zero specificity, forgiving parsing
#                 (unsupported arguments are dropped without
#                 invalidating the rule), rule-bucket anchoring.
#
#     modern-16.* @layer: cascade layers rank between origin and
#                 specificity (unlayered > later layer > earlier
#                 layer for normal declarations, reversed for
#                 !important), statement and block forms, nesting
#                 with @media and other layers, anonymous layers.
#
#     modern-17.* Grid stage A part 1 - property plumbing:
#                 display grid/inline-grid, grid-template-columns/rows
#                 track lists (px/%/fr/auto, repeat(N) expansion),
#                 grid-column/-row shorthands with "/" and span,
#                 degradation of unsupported forms (minmax, named
#                 lines) to earlier declarations.
#
#     modern-18.* Grid stage A part 2 - the layout engine
#                 (htmlgridlayout.c): explicit tracks, fr
#                 distribution, line placement + span, auto
#                 placement, gap, implicit rows.
#
# Note: when testing with properties, prefer 'color' - the initial value
# of e.g. 'border-top-width' is "medium" (2px), which is easy to confuse
# with a test value.
#
proc sourcefile {file} {
  set fname [file join [file dirname [info script]] $file]
  uplevel #0 [list source $fname]
}
sourcefile common.tcl

catch {destroy .h}
html .h
pack .h -fill both -expand 1
update

proc property {node prop} {
  return [$node property $prop]
}

proc idnode {id} {
  lindex [.h search "\[id=\"$id\"\]"] 0
}

#--------------------------------------------------------------------------
# modern-1.*: HTML5 vocabulary.
#
tcltest::test modern-1.0 {section becomes a real node with display block} -body {
  .h reset
  .h parse -final {
    <body><p id="one">para <mark id="m">hi</mark> text
    <section id="s"><h2>head</h2></section></body>
  }
  set s [lindex [.h search section] 0]
  list [$s tag] [property $s display] [[$s parent] tag]
} -result {section block body}

tcltest::test modern-1.1 {structural element implicitly closes an open <p>} -body {
  set kids {}
  foreach c [[idnode one] children] {
    if {[$c tag] ne ""} { lappend kids [$c tag] }
  }
  set kids
} -result {mark}

tcltest::test modern-1.2 {phrasing element <mark> stays inside <p>} -body {
  set m [idnode m]
  list [[$m parent] tag] [property $m background-color]
} -result {p yellow}

tcltest::test modern-1.3 {template content is not displayed} -body {
  .h reset
  .h parse -final {<body><template id="t"><div>x</div></template></body>}
  property [lindex [.h search template] 0] display
} -result {none}

tcltest::test modern-1.4 {global hidden attribute} -body {
  .h reset
  .h parse -final {<body><div hidden id="h">x</div><span hidden id="i">y</span></body>}
  list [property [idnode h] display] [property [idnode i] display]
} -result {none none}

tcltest::test modern-1.5 {figure default margins} -body {
  .h reset
  .h parse -final {<body><figure id="f">x</figure></body>}
  list [property [idnode f] display] [property [idnode f] margin-left]
} -result {block 40px}

tcltest::test modern-1.6 {nav/header/footer/main/aside/article are blocks} -body {
  .h reset
  .h parse -final {
    <body><nav id="a">n</nav><header id="b">h</header><footer id="c">f</footer>
    <main id="d">m</main><aside id="e">a</aside><article id="f">r</article></body>
  }
  set r {}
  foreach id {a b c d e f} { lappend r [property [idnode $id] display] }
  set r
} -result {block block block block block block}

tcltest::test modern-1.7 {previously-dead html.css rules now fire (del/ins/abbr)} -body {
  .h reset
  .h parse -final {<body><del id="d">a</del><ins id="i">b</ins></body>}
  list [property [idnode d] text-decoration] [property [idnode i] text-decoration]
} -result {line-through underline}

tcltest::test modern-1.8 {dialog hidden unless open} -body {
  .h reset
  .h parse -final {<body><dialog id="d1">x</dialog><dialog open id="d2">y</dialog></body>}
  list [property [idnode d1] display] [property [idnode d2] display]
} -result {none block}

#--------------------------------------------------------------------------
# modern-2.*: CSS3 selectors.
#
tcltest::test modern-2.0 {:root matches the document root only} -body {
  # background-color, not color: color is inherited and would leak to
  # the div, hiding what is being tested here.
  .h reset
  .h style { :root { background-color: red } }
  .h parse -final {<html><body><div id="d">x</div></body></html>}
  list [property [lindex [.h search html] 0] background-color] \
       [property [idnode d] background-color]
} -result {red transparent}

tcltest::test modern-2.1 {:empty} -body {
  .h reset
  .h style { div:empty { color: red } }
  .h parse -final {<body><div id="a"></div><div id="b">x</div></body>}
  list [property [idnode a] color] [property [idnode b] color]
} -result {red black}

tcltest::test modern-2.2 {:only-child} -body {
  .h reset
  .h style { span:only-child { color: red } }
  .h parse -final {<body>
    <b><span id="a">x</span></b>
    <i><span id="b">y</span><span id="c">z</span></i>
  </body>}
  list [property [idnode a] color] \
       [property [idnode b] color] [property [idnode c] color]
} -result {red black black}

tcltest::test modern-2.3 {:first-of-type and :last-of-type} -body {
  .h reset
  .h style {
    p:first-of-type { color: red }
    p:last-of-type { color: blue }
  }
  .h parse -final {<body>
    <div id="d">top</div>
    <p id="p1">one</p><p id="p2">two</p><p id="p3">three</p>
  </body>}
  list [property [idnode d] color] [property [idnode p1] color] \
       [property [idnode p2] color] [property [idnode p3] color]
} -result {black red black blue}

tcltest::test modern-2.4 {:nth-of-type counts same-tag siblings only} -body {
  .h reset
  .h style { p:nth-of-type(2) { color: red } }
  .h parse -final {<body>
    <div>zero</div><p id="p1">one</p><div>x</div><p id="p2">two</p>
  </body>}
  list [property [idnode p1] color] [property [idnode p2] color]
} -result {black red}

tcltest::test modern-2.5 {:nth-last-child} -body {
  .h reset
  .h style { li:nth-last-child(1) { color: red } li:nth-last-child(odd) { font-style: italic } }
  .h parse -final {<body><ul>
    <li id="l1">1</li><li id="l2">2</li><li id="l3">3</li>
  </ul></body>}
  list [property [idnode l1] color] [property [idnode l3] color] \
       [property [idnode l1] font-style] [property [idnode l2] font-style]
} -result {black red italic normal}

tcltest::test modern-2.6 {:not(.class)} -body {
  .h reset
  .h style { div:not(.keep) { color: red } }
  .h parse -final {<body>
    <div id="a">x</div><div class="keep" id="b">y</div><span id="c">z</span>
  </body>}
  list [property [idnode a] color] [property [idnode b] color] \
       [property [idnode c] color]
} -result {red black black}

tcltest::test modern-2.7 {:not([attr])} -body {
  .h reset
  .h style { p:not([lang]) { color: red } }
  .h parse -final {<body><p lang="en" id="a">x</p><p id="b">y</p></body>}
  list [property [idnode a] color] [property [idnode b] color]
} -result {black red}

tcltest::test modern-2.8 {:not(:first-child)} -body {
  .h reset
  .h style { li:not(:first-child) { color: red } }
  .h parse -final {<body><ul>
    <li id="l1">1</li><li id="l2">2</li><li id="l3">3</li>
  </ul></body>}
  list [property [idnode l1] color] [property [idnode l2] color] \
       [property [idnode l3] color]
} -result {black red red}

tcltest::test modern-2.9 {:not(tag)} -body {
  .h reset
  .h style { li :not(b) { color: red } }
  .h parse -final {<body><ul><li>
    <b id="a">x</b><i id="b">y</i>
  </li></ul></body>}
  list [property [idnode a] color] [property [idnode b] color]
} -result {black red}

tcltest::test modern-2.10 {:not takes the specificity of its argument} -body {
  # div:not(.b) = 1 type + 1 class = 101, beats .a = 100.
  .h reset
  .h style { .a { color: red } div:not(.b) { color: blue } }
  .h parse -final {<body><div class="a" id="d">x</div></body>}
  property [idnode d] color
} -result {blue}

tcltest::test modern-2.11 {new selectors work with the search command} -body {
  .h reset
  .h parse -final {<body>
    <div id="a"></div><div class="keep" id="b">y</div>
    <p id="p1">x</p><p id="p2">y</p>
  </body>}
  list [llength [.h search {div:empty}]] \
       [llength [.h search {div:not(.keep)}]] \
       [llength [.h search {p:last-of-type}]] \
       [llength [.h search {p:nth-last-child(1)}]]
} -result {1 1 1 1}

#--------------------------------------------------------------------------
# modern-3.*: the rem unit.
#
tcltest::test modern-3.0 {rem resolves against the root font, em against own} -body {
  .h reset
  .h style {
    html { font-size: 10px }
    body { font-size: 20px }
    div  { width: 5rem; margin-top: 2em; margin-left: 2rem; font-size: 20px }
  }
  .h parse -final {<html><body><div id="d">x</div></body></html>}
  list [property [idnode d] width] [property [idnode d] margin-top] \
       [property [idnode d] margin-left]
} -result {50px 40px 20px}

tcltest::test modern-3.1 {font-size in rem ignores the parent font} -body {
  .h reset
  .h style {
    html { font-size: 10px }
    body { font-size: 20px }
    span { font-size: 1.5rem }
  }
  .h parse -final {<html><body><span id="s">x</span></body></html>}
  property [idnode s] font-size
} -result {15px}

tcltest::test modern-3.2 {rem works for border widths} -body {
  .h reset
  .h style {
    html { font-size: 10px }
    div  { border-top-width: 2rem; border-top-style: solid }
  }
  .h parse -final {<html><body><div id="d">x</div></body></html>}
  property [idnode d] border-top-width
} -result {20px}

#--------------------------------------------------------------------------
# modern-4.*: currentColor.
#
tcltest::test modern-4.0 {currentColor resolves to the element's color} -body {
  .h reset
  .h style {
    #a { color: red;
         border-top-color: currentColor; background-color: currentColor }
  }
  .h parse -final {<body><div id="a">x</div></body>}
  list [property [idnode a] border-top-color] \
       [property [idnode a] background-color]
} -result {red red}

tcltest::test modern-4.1 {currentColor on color itself means inherit} -body {
  .h reset
  .h style {
    #b { color: blue }
    #b span { color: currentColor; border-top-color: currentColor }
  }
  .h parse -final {<body><div id="b"><span id="s">x</span></div></body>}
  list [property [idnode s] color] [property [idnode s] border-top-color]
} -result {blue blue}

tcltest::test modern-4.2 {currentColor is case-insensitive} -body {
  .h reset
  .h style { #c { color: red; border-top-color: currentcolor } }
  .h parse -final {<body><div id="c">x</div></body>}
  property [idnode c] border-top-color
} -result {red}

tcltest::test modern-2.12 {:not with unsupported argument kills the ruleset only} -body {
  .h reset
  set ::modern_errvar {}
  .h style -errorvar ::modern_errvar {
    p:not(:hover) { color: red }
    p { font-style: italic }
  }
  .h parse -final {<body><p id="p1">x</p></body>}
  list [property [idnode p1] color] [property [idnode p1] font-style] \
       [expr {[llength $::modern_errvar] > 0}]
} -result {black italic 1}

#--------------------------------------------------------------------------
# modern-5.*: white-space: pre-wrap / pre-line.
#
proc ws_heights {} {
  # Every div gets the same two-"line" content: a short first line, a
  # newline, then a second line too long for the 150px box.
  set txt "aa    bb\ncc dd ee ff gg hh ii jj kk ll mm nn oo pp"
  .h reset
  .h style {
    body { margin: 0 }
    div  { font-size: 10px; width: 150px }
    #pr  { white-space: pre }
    #pw  { white-space: pre-wrap }
    #pl  { white-space: pre-line }
  }
  .h parse -final "<html><body>
    <div id='ref'>x</div>
    <div id='pr'>$txt</div>
    <div id='pw'>$txt</div>
    <div id='pl'>$txt</div>
    <div id='nm'>$txt</div>
  </body></html>"
  set rb [.h bbox [idnode ref]]
  set h1 [expr {[lindex $rb 3] - [lindex $rb 1]}]
  set r {}
  foreach id {pr pw pl nm} {
    set bb [.h bbox [idnode $id]]
    lappend r [expr {([lindex $bb 3] - [lindex $bb 1]) / $h1}]
  }
  return $r
}

tcltest::test modern-5.0 {pre-wrap/pre-line: line counts} -body {
  # pre: newline honored, no wrapping           -> 2 lines
  # pre-wrap: newline honored, second line wraps -> 3 lines
  # pre-line: same line structure as pre-wrap    -> 3 lines
  # normal: newline collapses, wraps once        -> 2 lines
  ws_heights
} -result {2 3 3 2}

tcltest::test modern-5.1 {pre-wrap preserves space runs, pre-line collapses} -body {
  .h reset
  .h style {
    span { display: inline-block; font-size: 10px }
    #pw { white-space: pre-wrap }
    #pl { white-space: pre-line }
    #nm { white-space: normal }
  }
  .h parse -final "<html><body>
    <div><span id='pw'>aa    bb</span></div>
    <div><span id='pl'>aa    bb</span></div>
    <div><span id='nm'>aa    bb</span></div>
  </body></html>"
  foreach id {pw pl nm} {
    set bb [.h bbox [idnode $id]]
    set w($id) [expr {[lindex $bb 2] - [lindex $bb 0]}]
  }
  # pre-wrap keeps all four spaces; pre-line collapses them to one,
  # rendering exactly as wide as white-space normal.
  list [expr {$w(pw) > $w(pl)}] [expr {$w(pl) == $w(nm)}]
} -result {1 1}

#--------------------------------------------------------------------------
# modern-6.*: word-spacing.
#
tcltest::test modern-6.0 {word-spacing adds to each space} -body {
  .h reset
  .h style {
    span { display: inline-block; font-size: 10px }
    #ws { word-spacing: 10px }
  }
  .h parse -final "<html><body>
    <div><span id='nm'>a b c</span></div>
    <div><span id='ws'>a b c</span></div>
  </body></html>"
  foreach id {nm ws} {
    set bb [.h bbox [idnode $id]]
    set w($id) [expr {[lindex $bb 2] - [lindex $bb 0]}]
  }
  # two spaces, 10px extra each
  expr {$w(ws) - $w(nm)}
} -result {20}

#--------------------------------------------------------------------------
# modern-7.*: CSS custom properties + var().
#
tcltest::test modern-7.0 {basic var() substitution} -body {
  .h reset
  .h style { :root { --main: red } #a { color: var(--main) } }
  .h parse -final {<body><div id="a">x</div></body>}
  property [idnode a] color
} -result {red}

tcltest::test modern-7.1 {custom properties inherit and can be overridden} -body {
  .h reset
  .h style {
    :root { --main: red }
    #b { --main: blue }
    span { color: var(--main) }
  }
  .h parse -final {<body>
    <div><span id="s1">root value</span></div>
    <div id="b"><span id="s2">overridden</span></div>
  </body>}
  list [property [idnode s1] color] [property [idnode s2] color]
} -result {red blue}

tcltest::test modern-7.2 {var() fallback value} -body {
  .h reset
  .h style { #c { color: var(--missing, green) } }
  .h parse -final {<body><div id="c">x</div></body>}
  property [idnode c] color
} -result {green}

tcltest::test modern-7.3 {failed substitution falls back to earlier declaration} -body {
  .h reset
  .h style { #d { color: purple; color: var(--missing) } }
  .h parse -final {<body><div id="d">x</div></body>}
  property [idnode d] color
} -result {purple}

tcltest::test modern-7.4 {var() inside a shorthand} -body {
  .h reset
  .h style {
    :root { --main: red }
    #e { border: 2px solid var(--main) }
  }
  .h parse -final {<body><div id="e">x</div></body>}
  list [property [idnode e] border-top-color] \
       [property [idnode e] border-top-width]
} -result {red 2px}

tcltest::test modern-7.5 {var() holding a length, combined with rem} -body {
  .h reset
  .h style {
    :root { --size: 5rem; font-size: 10px }
    #f { width: var(--size); display: block }
  }
  .h parse -final {<body><div id="f">x</div></body>}
  property [idnode f] width
} -result {50px}

tcltest::test modern-7.6 {var() referencing another custom property} -body {
  .h reset
  .h style {
    :root { --main: red; --alias: var(--main) }
    #g { color: var(--alias) }
  }
  .h parse -final {<body><div id="g">x</div></body>}
  property [idnode g] color
} -result {red}

tcltest::test modern-7.7 {style attribute beats rules for custom properties} -body {
  .h reset
  .h style {
    :root { --main: red }
    #h { --main: yellow }
    .cls { --main: teal }
    #h span { color: var(--main) }
  }
  .h parse -final {<body>
    <div id="h" class="cls" style="--main: orange"><span id="s">x</span></div>
  </body>}
  property [idnode s] color
} -result {orange}

tcltest::test modern-7.8 {custom property declared and used in a style attribute} -body {
  .h reset
  .h parse -final {<body><div id="i" style="--z: navy; color: var(--z)">x</div></body>}
  property [idnode i] color
} -result {navy}

tcltest::test modern-7.9 {reference cycles are rejected, not fatal} -body {
  .h reset
  .h style {
    :root { --a: var(--b); --b: var(--a) }
    #j { color: purple; color: var(--a) }
  }
  .h parse -final {<body><div id="j">x</div></body>}
  property [idnode j] color
} -result {purple}

#--------------------------------------------------------------------------
# modern-8.*: conditional @media queries.
#
proc mq_setup {} {
  wm geometry . 400x300
  update
  .h reset
  .h style {
    #a { color: black }
    @media (max-width: 500px) {
      #a { color: red }
      #b { --tone: green }
    }
    @media (min-width: 501px) {
      #a { color: blue }
    }
    @media screen and (min-width: 200px) and (max-width: 4000px) {
      #c { color: purple }
    }
    @media print { #d { color: red } }
    @media (orientation: landscape) { #e { color: red } }
    #b span { color: var(--tone, black) }
  }
  .h parse -final {<html><body>
    <div id="a">x</div>
    <div id="b"><span id="s">y</span></div>
    <div id="c">z</div><div id="d">p</div><div id="e">o</div>
  </body></html>}
  update
}

tcltest::test modern-8.0 {conditional media queries at 400px} -body {
  mq_setup
  list [property [idnode a] color] [property [idnode s] color] \
       [property [idnode c] color] [property [idnode d] color] \
       [property [idnode e] color]
} -result {red green purple black black}

tcltest::test modern-8.1 {resize across the breakpoint restyles} -body {
  wm geometry . 700x300
  update
  after 200 {set ::mq_done 1}; vwait ::mq_done
  update
  list [property [idnode a] color] [property [idnode s] color]
} -result {blue black}

tcltest::test modern-8.2 {unconditional rules unaffected by resize} -body {
  set r [property [idnode c] color]
  wm geometry . {}
  update
  set r
} -result {purple}

tcltest::test modern-8.3 {minified @media: no space after the brace} -body {
  # The opening brace of an @media block used to be advanced past
  # inside parseAtRule, so without white-space after it the top-level
  # loop advance swallowed the first selector of the block.
  .h reset
  .h style "@media screen{b{color:#cc0000}i{color:#0000cc}}u{color:#00cc00}"
  .h parse -final {<body><b id="a">x</b><i id="b">y</i><u id="c">z</u></body>}
  list [property [idnode a] color] [property [idnode b] color] \
       [property [idnode c] color]
} -result {{#cc0000} #0000cc #00cc00}

#--------------------------------------------------------------------------
# modern-9.*: viewport units.
#
tcltest::test modern-9.0 {vw/vh/vmin/vmax resolve against the viewport} -body {
  wm geometry . 400x300
  update
  .h reset
  .h style {
    #a { width: 50vw; display: block }
    #b { height: 10vh; display: block }
    #c { width: 20vmin; display: block }
    #d { width: 20vmax; display: block }
    #e { font-size: 5vw }
  }
  .h parse -final {<html><body>
    <div id="a">a</div><div id="b">b</div><div id="c">c</div>
    <div id="d">d</div><div id="e">e</div>
  </body></html>}
  update
  list [property [idnode a] width] [property [idnode b] height] \
       [property [idnode c] width] [property [idnode d] width] \
       [property [idnode e] font-size]
} -result {200px 30px 60px 80px 20px}

tcltest::test modern-9.1 {viewport units track resizes} -body {
  wm geometry . 600x300
  update
  after 200 {set ::vw_done 1}; vwait ::vw_done
  update
  set r [list [property [idnode a] width] [property [idnode e] font-size]]
  wm geometry . {}
  update
  set r
} -result {300px 30px}

#--------------------------------------------------------------------------
# modern-10.*: calc() stage 1.
#
tcltest::test modern-10.0 {calc arithmetic} -body {
  .h reset
  .h style {
    html { font-size: 10px }
    #a { width: calc(100px + 50px); display: block }
    #b { width: calc(10rem / 2); display: block }
    #c { width: calc((10px + 20px) * 3); display: block }
    #d { width: calc(2 * 3rem); display: block }
    #e { width: calc(1in); display: block }
    #f { margin-left: calc(20px - 30px); display: block }
  }
  .h parse -final {<html><body>
    <div id="a">a</div><div id="b">b</div><div id="c">c</div>
    <div id="d">d</div><div id="e">e</div><div id="f">f</div>
  </body></html>}
  list [property [idnode a] width] [property [idnode b] width] \
       [property [idnode c] width] [property [idnode d] width] \
       [property [idnode e] width] [property [idnode f] margin-left]
} -result {150px 50px 90px 60px 96px -10px}

tcltest::test modern-10.1 {unsupported calc invalidates, cascade falls back} -body {
  # calc(100% - 20px) became SUPPORTED in stage 2 (see modern-13.*);
  # mixed relative units are still invalid and must fall back.
  .h reset
  .h style {
    #a { width: 77px; width: calc(1em + 5px); display: block }
    #b { width: 88px; width: calc(50% + 1em); display: block }
  }
  .h parse -final {<body><div id="a">a</div><div id="b">b</div></body>}
  list [property [idnode a] width] [property [idnode b] width]
} -result {77px 88px}

tcltest::test modern-10.2 {var() inside calc} -body {
  .h reset
  .h style {
    :root { --gap: 8px }
    #j { width: calc(var(--gap) * 4); display: block }
  }
  .h parse -final {<body><div id="j">x</div></body>}
  property [idnode j] width
} -result {32px}

#--------------------------------------------------------------------------
# modern-11.*: flexbox stage A.
#
proc flexpage {css html} {
  .h reset
  .h style "body { margin: 0; padding: 0 } $css"
  .h parse -final "<body>$html</body>"
  update idletasks
}
proc xw {node} {
  # bbox -> {x width}
  foreach {x1 y1 x2 y2} [.h bbox $node] break
  list $x1 [expr {$x2 - $x1}]
}
proc yh {node} {
  # bbox -> {y height}
  foreach {x1 y1 x2 y2} [.h bbox $node] break
  list $y1 [expr {$y2 - $y1}]
}

tcltest::test modern-11.0 {flex shorthand readback} -body {
  .h reset
  .h style {
    #a { flex: 1 0 0% }
    #b { flex: none }
    #c { flex: 2 }
    #d { flex: 30% }
  }
  .h parse -final {<body><div id="a">a</div><div id="b">b</div>
    <div id="c">c</div><div id="d">d</div></body>}
  set res {}
  foreach id {a b c d} {
    set n [idnode $id]
    lappend res [property $n flex-grow] [property $n flex-shrink] \
        [property $n flex-basis]
  }
  set res
} -result {1 0 0.0% 0 0 auto 2 1 0px 1 1 30.0%}

tcltest::test modern-11.1 {equal flex-grow split} -body {
  flexpage {
    #f { display: flex; width: 600px }
    #f > div { flex: 1 0 0% }
  } {<div id="f"><div id="a">a</div><div id="b">b</div><div id="c">c</div></div>}
  list [xw [idnode a]] [xw [idnode b]] [xw [idnode c]]
} -result {{0 200} {200 200} {400 200}}

tcltest::test modern-11.2 {justify-content space-between} -body {
  flexpage {
    #f { display: flex; width: 600px; justify-content: space-between }
    #f > div { width: 100px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div><div id="c">c</div></div>}
  list [xw [idnode a]] [xw [idnode b]] [xw [idnode c]]
} -result {{0 100} {250 100} {500 100}}

tcltest::test modern-11.3 {justify-content center} -body {
  flexpage {
    #f { display: flex; width: 600px; justify-content: center }
    #f > div { width: 100px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [xw [idnode a]] [xw [idnode b]]
} -result {{200 100} {300 100}}

tcltest::test modern-11.4 {gap between items} -body {
  flexpage {
    #f { display: flex; width: 600px; gap: 30px }
    #f > div { flex: 1 0 0% }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [xw [idnode a]] [xw [idnode b]]
} -result {{0 285} {315 285}}

tcltest::test modern-11.5 {column direction with definite height} -body {
  flexpage {
    #f { display: flex; flex-direction: column; width: 600px; height: 300px }
    #f > div { flex: 1 0 0% }
  } {<div id="f"><div id="a">a</div><div id="b">b</div><div id="c">c</div></div>}
  list [yh [idnode a]] [yh [idnode b]] [yh [idnode c]]
} -result {{0 100} {100 100} {200 100}}

tcltest::test modern-11.6 {auto main margin absorbs free space} -body {
  flexpage {
    #f { display: flex; width: 600px }
    #f > div { flex: 0 0 150px }
    #b { margin-left: auto }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [xw [idnode a]] [xw [idnode b]]
} -result {{0 150} {450 150}}

tcltest::test modern-11.7 {align-items center} -body {
  flexpage {
    #f { display: flex; width: 600px; height: 90px; align-items: center }
    #a { height: 80px; width: 50px }
    #b { height: 20px; width: 50px }
  } {<div id="f"><div id="a"></div><div id="b"></div></div>}
  list [yh [idnode a]] [yh [idnode b]]
} -result {{5 80} {35 20}}

tcltest::test modern-11.8 {order reorders items} -body {
  flexpage {
    #f { display: flex; width: 600px }
    #f > div { flex: 1 0 0% }
    #c { order: -1 }
  } {<div id="f"><div id="a">1</div><div id="b">2</div><div id="c">3</div></div>}
  list [xw [idnode c]] [xw [idnode a]] [xw [idnode b]]
} -result {{0 200} {200 200} {400 200}}

tcltest::test modern-11.9 {row-reverse packs at the right edge} -body {
  # In row-reverse the main axis is flipped: the default
  # justify-content:flex-start packs items at the RIGHT edge,
  # with the first item rightmost.
  flexpage {
    #f { display: flex; flex-direction: row-reverse; width: 600px }
    #f > div { flex: 0 0 100px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [xw [idnode a]] [xw [idnode b]]
} -result {{500 100} {400 100}}

tcltest::test modern-11.10 {shrink proportional to factor times base} -body {
  flexpage {
    #f { display: flex; width: 300px }
    #a { flex: 0 1 400px; overflow: hidden }
    #b { flex: 0 1 200px; overflow: hidden }
  } {<div id="f"><div id="a"></div><div id="b"></div></div>}
  list [xw [idnode a]] [xw [idnode b]]
} -result {{0 200} {200 100}}

tcltest::test modern-11.11 {max-width freezes a growing item} -body {
  flexpage {
    #f { display: flex; width: 600px }
    #f > div { flex: 1 0 0% }
    #b { max-width: 100px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div><div id="c">c</div></div>}
  list [xw [idnode a]] [xw [idnode b]] [xw [idnode c]]
} -result {{0 250} {250 100} {350 250}}

tcltest::test modern-11.12 {align-items stretch is the default} -body {
  flexpage {
    #f { display: flex; width: 600px; height: 120px }
    #a { width: 100px }
  } {<div id="f"><div id="a"></div></div>}
  yh [idnode a]
} -result {0 120}

tcltest::test modern-11.13 {inline-flex shrinks to fit} -body {
  flexpage {
    #f { display: inline-flex }
    #f > div { width: 50px; height: 20px }
  } {<div><div id="f"><div>a</div><div>b</div></div></div>}
  lindex [xw [idnode f]] 1
} -result {100}

tcltest::test modern-11.14 {text-only flex container falls back to normal flow} -body {
  flexpage {
    #f { display: flex; width: 600px }
  } {<div id="f">plain text</div>}
  # The text must still render: the container gets a text height
  expr {[lindex [yh [idnode f]] 1] > 0}
} -result {1}

tcltest::test modern-11.15 {nested flex containers} -body {
  flexpage {
    #outer { display: flex; width: 600px }
    #outer > div { flex: 1 0 0% }
    #inner { display: flex }
    #inner > div { flex: 1 0 0% }
  } {<div id="outer"><div>x</div><div id="inner"><div id="a">a</div><div id="b">b</div></div></div>}
  list [xw [idnode a]] [xw [idnode b]]
} -result {{300 150} {450 150}}

tcltest::test modern-11.16 {percentage flex-basis} -body {
  flexpage {
    #f { display: flex; width: 600px }
    #a { flex: 0 0 25% }
    #b { flex: 1 0 0% }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [xw [idnode a]] [xw [idnode b]]
} -result {{0 150} {150 450}}

tcltest::test modern-11.17 {box-sizing border-box on flex items} -body {
  flexpage {
    #f { display: flex; width: 600px }
    #f > div { flex: 0 0 200px; box-sizing: border-box;
               padding: 0 20px; border: 5px solid black }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  # border-box: the 200px basis includes padding+border, so the
  # border boxes are exactly 200px wide and adjacent
  list [xw [idnode a]] [xw [idnode b]]
} -result {{0 200} {200 200}}

#--------------------------------------------------------------------------
# modern-12.*: flexbox stage B (multi-line).
#
proc relbox {id base} {
  # bbox of $id relative to the top-left corner of $base
  foreach {x1 y1 x2 y2} [.h bbox [idnode $id]] break
  foreach {bx1 by1 bx2 by2} [.h bbox [idnode $base]] break
  list [expr {$x1-$bx1}] [expr {$y1-$by1}] \
       [expr {$x2-$bx1}] [expr {$y2-$by1}]
}

tcltest::test modern-12.0 {flex-wrap breaks lines greedily} -body {
  flexpage {
    #f { display: flex; flex-wrap: wrap; width: 600px }
    #f > div { flex: 0 0 250px; height: 20px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div><div id="c">c</div></div>}
  list [relbox a f] [relbox b f] [relbox c f]
} -result {{0 0 250 20} {250 0 500 20} {0 20 250 40}}

tcltest::test modern-12.1 {align-content space-between} -body {
  flexpage {
    #f { display: flex; flex-wrap: wrap; width: 600px; height: 200px;
         align-content: space-between }
    #f > div { flex: 0 0 400px; height: 30px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [relbox a f] [relbox b f]
} -result {{0 0 400 30} {0 170 400 200}}

tcltest::test modern-12.2 {align-content center} -body {
  flexpage {
    #f { display: flex; flex-wrap: wrap; width: 600px; height: 100px;
         align-content: center }
    #f > div { flex: 0 0 400px; height: 20px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [relbox a f] [relbox b f]
} -result {{0 30 400 50} {0 50 400 70}}

tcltest::test modern-12.3 {align-content stretch grows the lines} -body {
  # Two 20px-tall items with definite heights on two lines in a 100px
  # container: each LINE stretches to 50px, the items keep their
  # height and sit at their line's start.
  flexpage {
    #f { display: flex; flex-wrap: wrap; width: 600px; height: 100px }
    #f > div { flex: 0 0 400px; height: 20px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [relbox a f] [relbox b f]
} -result {{0 0 400 20} {0 50 400 70}}

tcltest::test modern-12.4 {wrap-reverse stacks lines from the cross end} -body {
  # Cross axis flips: with align-content flex-start the FIRST line is
  # packed at the BOTTOM edge, later lines above it.
  flexpage {
    #f { display: flex; flex-wrap: wrap-reverse; width: 600px;
         height: 100px; align-content: flex-start }
    #f > div { flex: 0 0 400px; height: 20px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div></div>}
  list [relbox a f] [relbox b f]
} -result {{0 80 400 100} {0 60 400 80}}

tcltest::test modern-12.5 {two-axis gap with wrapping} -body {
  flexpage {
    #f { display: flex; flex-wrap: wrap; width: 600px; gap: 10px 20px }
    #f > div { flex: 0 0 280px; height: 20px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div><div id="c">c</div></div>}
  # column-gap 20 between items, row-gap 10 between lines
  list [relbox a f] [relbox b f] [relbox c f]
} -result {{0 0 280 20} {300 0 580 20} {0 30 280 50}}

tcltest::test modern-12.6 {column wrapping stacks lines horizontally} -body {
  flexpage {
    #f { display: flex; flex-direction: column; flex-wrap: wrap;
         width: 600px; height: 100px; align-content: flex-start }
    #f > div { flex: 0 0 60px; width: 100px }
  } {<div id="f"><div id="a">a</div><div id="b">b</div><div id="c">c</div></div>}
  # 60+60 > 100: one item per line; lines side by side, 100px wide
  list [relbox a f] [relbox b f] [relbox c f]
} -result {{0 0 100 60} {100 0 200 60} {200 0 300 60}}

tcltest::test modern-12.7 {baseline alignment} -body {
  # The 30px-font item has the larger ascent, so the 10px-font item is
  # pushed down until the baselines meet. Exact offsets depend on the
  # font, so only the ordering is asserted.
  flexpage {
    #f { display: flex; align-items: baseline; width: 600px }
    #big { font-size: 30px } #small { font-size: 10px }
  } {<div id="f"><div id="big">Big</div><div id="small">tiny</div></div>}
  foreach {x1 bigy x2 y2} [relbox big f] break
  foreach {x3 smally x4 y4} [relbox small f] break
  list [expr {$bigy == 0}] [expr {$smally > 0}]
} -result {1 1}

tcltest::test modern-12.8 {flex-flow shorthand readback} -body {
  .h reset
  .h style {
    #a { flex-flow: column wrap }
    #b { flex-flow: wrap-reverse }
    #c { flex-flow: row-reverse }
  }
  .h parse -final {<body><div id="a">a</div><div id="b">b</div>
    <div id="c">c</div></body>}
  set res {}
  foreach id {a b c} {
    set n [idnode $id]
    lappend res [property $n flex-direction] [property $n flex-wrap]
  }
  set res
} -result {column wrap row wrap-reverse row-reverse nowrap}

tcltest::test modern-12.9 {nowrap is unaffected by align-content} -body {
  # A single-line container ignores align-content: the line fills the
  # definite height and stretch items fill the line (same as stage A).
  flexpage {
    #f { display: flex; width: 600px; height: 120px;
         align-content: flex-end }
    #a { width: 100px }
  } {<div id="f"><div id="a"></div></div>}
  relbox a f
} -result {0 0 100 120}

#--------------------------------------------------------------------------
# modern-13.*: calc() stage 2 (percentage + absolute length).
#
tcltest::test modern-13.0 {calc % + px resolves against the containing block} -body {
  flexpage {
    #wrap { width: 600px }
    #a { width: calc(100% - 20px); display: block; height: 10px }
    #b { width: calc(50% + 10px); display: block; height: 10px }
  } {<div id="wrap"><div id="a">.</div><div id="b">.</div></div>}
  list [xw [idnode a]] [xw [idnode b]] \
       [property [idnode a] width] [property [idnode b] width]
} -result {{0 580} {0 310} {calc(100% - 20px)} {calc(50% + 10px)}}

tcltest::test modern-13.1 {pure-percent calc folds to a plain percentage} -body {
  flexpage {
    #wrap { width: 600px }
    #a { width: calc(100% / 4); display: block; height: 10px }
  } {<div id="wrap"><div id="a">.</div></div>}
  list [xw [idnode a]] [property [idnode a] width]
} -result {{0 150} 25.0%}

tcltest::test modern-13.2 {multiplication distributes over both components} -body {
  flexpage {
    #wrap { width: 600px }
    #a { width: calc(2 * (25% - 5px)); display: block; height: 10px }
  } {<div id="wrap"><div id="a">.</div></div>}
  list [xw [idnode a]] [property [idnode a] width]
} -result {{0 290} {calc(50% - 10px)}}

tcltest::test modern-13.3 {calc % in margins} -body {
  flexpage {
    #wrap { width: 600px }
    #a { margin-left: calc(25% + 5px); width: 50px; display: block;
         height: 10px }
  } {<div id="wrap"><div id="a">.</div></div>}
  xw [idnode a]
} -result {155 50}

tcltest::test modern-13.4 {var() inside a stage-2 calc} -body {
  flexpage {
    :root { --off: 30px }
    #wrap { width: 600px }
    #a { width: calc(100% - var(--off)); display: block; height: 10px }
  } {<div id="wrap"><div id="a">.</div></div>}
  xw [idnode a]
} -result {0 570}

tcltest::test modern-13.5 {calc % on position relative left} -body {
  flexpage {
    #wrap { width: 600px }
    #a { position: relative; left: calc(50% - 10px); width: 40px;
         height: 10px }
  } {<div id="wrap"><div id="a">.</div></div>}
  xw [idnode a]
} -result {290 40}

tcltest::test modern-13.6 {calc % with flex-basis} -body {
  flexpage {
    #f { display: flex; width: 600px }
    #a { flex: 0 0 calc(50% - 100px); height: 10px }
    #b { flex: 1 0 0%; height: 10px }
  } {<div id="f"><div id="a">.</div><div id="b">.</div></div>}
  list [xw [idnode a]] [xw [idnode b]]
} -result {{0 200} {200 400}}

tcltest::test modern-13.7 {% with non-absolute units still falls back} -body {
  flexpage {
    #wrap { width: 600px }
    #a { width: 111px; width: calc(50% + 1em); display: block }
    #b { width: 122px; width: calc(50% + 2vw); display: block }
    #c { width: 133px; width: calc(50% + 3); display: block }
  } {<div id="wrap"><div id="a">.</div><div id="b">.</div>
     <div id="c">.</div></div>}
  list [property [idnode a] width] [property [idnode b] width] \
       [property [idnode c] width]
} -result {111px 122px 133px}

#--------------------------------------------------------------------------
# modern-14.*: options-menu items.
#
tcltest::test modern-14.0 {outline shorthand expands} -body {
  .h reset
  .h style {
    #a { outline: 3px solid red }
    #b { outline: blue dotted }
  }
  .h parse -final {<body><div id="a">a</div><div id="b">b</div></body>}
  list [property [idnode a] outline-width] \
       [property [idnode a] outline-style] \
       [property [idnode a] outline-color] \
       [property [idnode b] outline-width] \
       [property [idnode b] outline-style] \
       [property [idnode b] outline-color]
} -result {3px solid red 2px dotted blue}

tcltest::test modern-14.1 {outline via :focus dynamic condition} -body {
  .h reset
  .h style {
    #c:focus { outline: 2px solid green }
  }
  .h parse -final {<body><div id="c">c</div></body>}
  set n [idnode c]
  set before [property $n outline-style]
  $n dynamic set focus
  update idletasks
  list $before [property $n outline-style] [property $n outline-color]
} -result {none solid green}

tcltest::test modern-14.2 {box-shadow parses offsets, spread and color} -body {
  .h reset
  .h style {
    #a { box-shadow: 10px 10px gray }
    #b { box-shadow: 4px 4px 8px 2px red }
    #c { color: blue; box-shadow: 5px 5px }
  }
  .h parse -final {<body><div id="a">a</div><div id="b">b</div>
    <div id="c">c</div></body>}
  # blur (the 3rd length) is parsed but rendered sharp: readback
  # always reports 0px blur. Omitted color = currentColor.
  list [property [idnode a] box-shadow] [property [idnode b] box-shadow] \
       [property [idnode c] box-shadow]
} -result {{10px 10px 0px 0px gray} {4px 4px 0px 2px red} {5px 5px 0px 0px blue}}

tcltest::test modern-14.3 {unsupported box-shadow forms fall back} -body {
  .h reset
  .h style {
    #a { box-shadow: 3px 3px gray; box-shadow: inset 2px 2px red }
    #b { box-shadow: 3px 3px gray; box-shadow: 1px 1px red, 2px 2px blue }
    #c { box-shadow: 3px 3px gray; box-shadow: 1em 1em red }
  }
  .h parse -final {<body><div id="a">a</div><div id="b">b</div>
    <div id="c">c</div></body>}
  # inset, shadow lists, and non-absolute lengths all invalidate the
  # declaration so the earlier one applies
  list [property [idnode a] box-shadow] [property [idnode b] box-shadow] \
       [property [idnode c] box-shadow]
} -result {{3px 3px 0px 0px gray} {3px 3px 0px 0px gray} {3px 3px 0px 0px gray}}

tcltest::test modern-14.4 {box-shadow rgba color (white-blend approximation)} -body {
  .h reset
  .h style { #a { box-shadow: 4px 4px rgba(0,0,0,0.5) } }
  .h parse -final {<body><div id="a">a</div></body>}
  property [idnode a] box-shadow
} -result {4px 4px 0px 0px #808080}

tcltest::test modern-14.5 {background-size computed values} -body {
  # The paint-level scaling (contain/cover geometry) was verified
  # pixel-exactly during development; here the parse/readback contract
  # is locked in.
  .h reset
  .h style {
    #a { background-size: cover }
    #b { background-size: contain }
    #c { background-size: 120px 30px }
    #d { background-size: 25% }
    #e { background-size: 50% auto }
  }
  .h parse -final {<body><div id="a">a</div><div id="b">b</div>
    <div id="c">c</div><div id="d">d</div><div id="e">e</div></body>}
  set res {}
  foreach id {a b c d e} {
    lappend res [property [idnode $id] background-size]
  }
  set res
} -result {cover contain {120px 30px} {25% auto} {50% auto}}

tcltest::test modern-14.6 {unsupported background-size falls back} -body {
  .h reset
  .h style {
    #a { background-size: 40px; background-size: 2em }
    #b { background-size: 40px; background-size: -10px }
  }
  .h parse -final {<body><div id="a">a</div><div id="b">b</div></body>}
  # em and negative lengths invalidate; the earlier declaration wins
  list [property [idnode a] background-size] \
       [property [idnode b] background-size]
} -result {{40px auto} {40px auto}}

#--------------------------------------------------------------------------
# modern-15.*: :is() and :where().
#
tcltest::test modern-15.0 {:is() OR-matches its alternatives} -body {
  .h reset
  .h style {
    :is(h1, h2) { color: #ff0000 }
  }
  .h parse -final {<body>
    <h1 id="a">one</h1><h2 id="b">two</h2><h3 id="c">three</h3>
  </body>}
  list [property [idnode a] color] [property [idnode b] color] \
       [property [idnode c] color]
} -result {{#ff0000} #ff0000 black}

tcltest::test modern-15.1 {:is() takes the max argument specificity} -body {
  # :is(#nosuch, .small) has specificity 10000 (the id argument counts
  # even though only the class alternative matches), so the later
  # plain .small rule (100) must lose.
  .h reset
  .h style {
    :is(#nosuch, .small) { margin-left: 7px }
    .small { margin-left: 3px }
  }
  .h parse -final {<body><div id="a" class="small">x</div></body>}
  property [idnode a] margin-left
} -result {7px}

tcltest::test modern-15.2 {:where() has zero specificity} -body {
  # :where(#nope, .w) computes specificity 0, so even a bare type
  # selector (1) declared EARLIER must win.
  .h reset
  .h style {
    p { color: #0000ff }
    :where(#nope, .w) { color: #00ff00 }
  }
  .h parse -final {<body><p id="a" class="w">para</p></body>}
  property [idnode a] color
} -result {#0000ff}

tcltest::test modern-15.3 {forgiving list drops only the bad alternatives} -body {
  # div:hover (compound) and :cranky (unsupported) are dropped; the
  # .keep alternative must still match. A list whose every argument
  # is dropped matches nothing but must not invalidate the rule for
  # its group sibling (.also).
  .h reset
  .h style {
    :is(.miss, div:hover, .keep) { color: #ffff00 }
    :is(:cranky), .also { color: #123456 }
  }
  .h parse -final {<body>
    <div id="a" class="keep">forgiven</div>
    <div id="b" class="also">sibling survives</div>
    <div id="c">plain</div>
  </body>}
  list [property [idnode a] color] [property [idnode b] color] \
       [property [idnode c] color]
} -result {{#ffff00} #123456 black}

tcltest::test modern-15.4 {compound selectors around :is() anchor correctly} -body {
  # span:is(.a) is filed in the by-tag bucket under "span" and
  # .x:is(div) in the by-class bucket under "x": both bucket paths
  # must still consult the :is() condition.
  .h reset
  .h style {
    span:is(.a) { color: #654321 }
    .x:is(div, section) { color: #112233 }
  }
  .h parse -final {<body>
    <span id="a" class="a">yes</span><span id="b">no</span>
    <div id="c" class="x">yes</div><p id="d" class="x">no</p>
  </body>}
  list [property [idnode a] color] [property [idnode b] color] \
       [property [idnode c] color] [property [idnode d] color]
} -result {{#654321} black #112233 black}

tcltest::test modern-15.5 {:is() combines with combinators} -body {
  .h reset
  .h style {
    #wrap :is(.a, .b) > i { color: #ff00ff }
  }
  .h parse -final {<body><div id="wrap">
    <div class="a"><i id="a">hit</i></div>
    <div class="c"><i id="b">miss</i></div>
  </div><div class="b"><i id="c">outside wrap</i></div></body>}
  list [property [idnode a] color] [property [idnode b] color] \
       [property [idnode c] color]
} -result {{#ff00ff} black black}

tcltest::test modern-15.6 {:is() accepts attribute and pseudo arguments} -body {
  .h reset
  .h style {
    li:is(:first-child, [data-hot="1"]) { color: #ee0000 }
  }
  .h parse -final {<body><ul>
    <li id="a">first</li>
    <li id="b">second</li>
    <li id="c" data-hot="1">hot</li>
  </ul></body>}
  list [property [idnode a] color] [property [idnode b] color] \
       [property [idnode c] color]
} -result {{#ee0000} black #ee0000}

tcltest::test modern-15.7 {:where() reset pattern is overridable by anything} -body {
  # The Tailwind/modern-normalize idiom: a :where() reset must lose
  # to any later author rule, however weak.
  .h reset
  .h style {
    :where(h1, h2, h3) { margin-top: 0px; margin-bottom: 0px }
    h2 { margin-bottom: 9px }
  }
  .h parse -final {<body><h2 id="a">t</h2></body>}
  list [property [idnode a] margin-top] [property [idnode a] margin-bottom]
} -result {0px 9px}

#--------------------------------------------------------------------------
# modern-16.*: @layer cascade layers.
#
tcltest::test modern-16.0 {unlayered rules beat layered ones} -body {
  # Layers rank BEFORE specificity: the un-layered type selector must
  # beat the layered id selector.
  .h reset
  .h style {
    @layer base { #a { color: #ff0000 } }
    div { color: #00ff00 }
  }
  .h parse -final {<body><div id="a">x</div></body>}
  property [idnode a] color
} -result {#00ff00}

tcltest::test modern-16.1 {declaration order ranks layers, not block order} -body {
  # The Tailwind-style preamble pre-declares the order; utilities is
  # last so it wins although its block appears before base's.
  .h reset
  .h style {
    @layer theme, base, utilities;
    @layer utilities { .u { margin-left: 9px } }
    @layer base { .u { margin-left: 1px } }
  }
  .h parse -final {<body><div id="a" class="u">x</div></body>}
  property [idnode a] margin-left
} -result {9px}

tcltest::test modern-16.2 {@media nests inside @layer} -body {
  # The rule after the inner @media block must still be in layer "a"
  # (the block-close pop restores the layer, not clears it).
  .h reset
  .h style {
    @layer a {
      @media (min-width: 10px) { .m { color: #112233 } }
      .n { color: #445566 }
    }
    .n { color: #778899 }
  }
  .h parse -final {<body><i id="m" class="m">m</i><i id="n" class="n">n</i></body>}
  list [property [idnode m] color] [property [idnode n] color]
} -result {{#112233} #778899}

tcltest::test modern-16.3 {minified @layer blocks} -body {
  .h reset
  .h style "@layer a{b{color:#cc0000}}@layer b{i{color:#0000cc}}u{color:#00cc00}"
  .h parse -final {<body><b id="p">x</b><i id="q">y</i><u id="r">z</u></body>}
  list [property [idnode p] color] [property [idnode q] color] \
       [property [idnode r] color]
} -result {{#cc0000} #0000cc #00cc00}

tcltest::test modern-16.4 {anonymous layers are distinct} -body {
  .h reset
  .h style {
    @layer { .y { color: #111111 } }
    @layer { .y { color: #222222 } }
  }
  .h parse -final {<body><div id="a" class="y">x</div></body>}
  property [idnode a] color
} -result {#222222}

tcltest::test modern-16.5 {layer order is reversed for !important} -body {
  # Earlier-layer !important beats later-layer !important, and any
  # layered !important beats unlayered !important.
  .h reset
  .h style {
    @layer first { .z { color: #101010 !important } }
    @layer second { .z { color: #202020 !important } }
    .z { color: #404040 !important }
  }
  .h parse -final {<body><div id="a" class="z">x</div></body>}
  property [idnode a] color
} -result {#101010}

tcltest::test modern-16.6 {nested layer blocks flatten to dotted names} -body {
  # o.in1 and o.in2 are distinct sub-layers; the later-declared one
  # wins. A top-level rule still beats both.
  .h reset
  .h style {
    @layer o {
      @layer in1 { .v { color: #515151 } }
      @layer in2 { .v { color: #626262 } }
      .w { color: #737373 }
    }
  }
  .h parse -final {<body><div id="a" class="v">x</div>
    <div id="b" class="w v">y</div></body>}
  list [property [idnode a] color] [property [idnode b] color]
} -result {{#626262} #737373}

#--------------------------------------------------------------------------
# modern-17.*: Grid stage A part 1 - property plumbing.
#
tcltest::test modern-17.0 {display grid and inline-grid; track lists} -body {
  .h reset
  .h style {
    #g  { display: grid;
          grid-template-columns: 100px 1fr repeat(2, auto 2fr); }
    #g2 { display: inline-grid; grid-template-rows: 50% 30px; }
  }
  .h parse -final {<body>
    <div id="g"><div>A</div></div><div id="g2"></div></body>}
  list [property [idnode g] display] \
       [property [idnode g] grid-template-columns] \
       [property [idnode g] grid-template-rows] \
       [property [idnode g2] display] \
       [property [idnode g2] grid-template-rows]
} -result {grid {100px 1fr auto 2fr auto 2fr} none inline-grid {50% 30px}}

tcltest::test modern-17.1 {grid-column/-row shorthands: /, span, bare int} -body {
  .h reset
  .h style {
    #a { grid-column: 2 / 4; grid-row: span 2; }
    #b { grid-column: 1 / span 2; grid-row: 3; }
    #c { grid-column-start: span 3; grid-row-end: -1; }
  }
  .h parse -final {<body><div id="a">A</div><div id="b">B</div>
    <div id="c">C</div></body>}
  list [property [idnode a] grid-column-start] \
       [property [idnode a] grid-column-end] \
       [property [idnode a] grid-row-start] \
       [property [idnode a] grid-row-end] \
       [property [idnode b] grid-column-end] \
       [property [idnode b] grid-row-start] \
       [property [idnode c] grid-column-start] \
       [property [idnode c] grid-row-end]
} -result {2 4 {span 2} auto {span 2} 3 {span 3} -1}

tcltest::test modern-17.2 {unsupported grid forms degrade to earlier rules} -body {
  # minmax() (stage B) and a custom-ident span invalidate their
  # declarations; the earlier declarations win. The valid 'color'
  # in the same block still applies.
  .h reset
  .h style {
    #g { grid-template-columns: 10px 20px; grid-column-start: 2; }
    #g { grid-template-columns: minmax(0, 1fr);
         grid-column-start: span2;
         color: #123456; }
  }
  .h parse -final {<body><div id="g">x</div></body>}
  list [property [idnode g] grid-template-columns] \
       [property [idnode g] grid-column-start] \
       [property [idnode g] color]
} -result {{10px 20px} 2 #123456}

tcltest::test modern-17.3 {grid placement inherit and auto forms} -body {
  .h reset
  .h style {
    #p { grid-column-start: 3; grid-template-columns: 1fr 2fr; }
    #k { grid-column-start: inherit; grid-column-end: auto;
         grid-template-columns: inherit; }
  }
  .h parse -final {<body><div id="p"><div id="k">x</div></div></body>}
  list [property [idnode k] grid-column-start] \
       [property [idnode k] grid-column-end] \
       [property [idnode k] grid-template-columns]
} -result {3 auto {1fr 2fr}}

#--------------------------------------------------------------------------
# modern-18.*: Grid stage A part 2 - the layout engine. All geometry
# uses fixed pixel sizes, so the assertions are font-independent.
#
proc gridbox {id} { .h bbox [idnode $id] }

tcltest::test modern-18.0 {fixed + fr columns fill the container} -body {
  .h reset
  .h style {
    body { margin: 0; padding: 0; }
    div { margin: 0; }
    #g { display: grid; grid-template-columns: 100px 1fr 2fr;
         width: 610px; }
    .c { height: 20px; }
  }
  .h parse -final {<body><div id="g">
    <div class="c" id="a">a</div><div class="c" id="b">b</div>
    <div class="c" id="c">c</div></div></body>}
  # free = 610 - 100 = 510; 1fr = 170, 2fr = 340
  list [gridbox a] [gridbox b] [gridbox c]
} -result {{0 0 100 20} {100 0 270 20} {270 0 610 20}}

tcltest::test modern-18.1 {repeat() + gap + auto-placement with a span} -body {
  .h reset
  .h style {
    body { margin: 0; padding: 0; }
    div { margin: 0; }
    #g { display: grid; grid-template-columns: repeat(3, 1fr);
         gap: 10px; width: 320px; }
    .c { height: 30px; }
    #s { grid-column: 1 / 3; }
  }
  .h parse -final {<body><div id="g">
    <div class="c" id="d">d</div><div class="c" id="e">e</div>
    <div class="c" id="f">f</div><div class="c" id="s">s</div>
    </div></body>}
  # 3 x 100px columns; s spans columns 1-2 on the second row
  list [gridbox d] [gridbox e] [gridbox f] [gridbox s]
} -result {{0 0 100 30} {110 0 210 30} {220 0 320 30} {0 40 210 70}}

tcltest::test modern-18.2 {explicit line placement addresses a cell} -body {
  .h reset
  .h style {
    body { margin: 0; padding: 0; }
    div { margin: 0; }
    #g { display: grid; grid-template-columns: 50px 50px;
         grid-template-rows: 40px 40px; width: 100px; }
    #p { grid-column: 2; grid-row: 2; }
  }
  .h parse -final {<body><div id="g"><div id="p">p</div></div></body>}
  # The single item sits in the bottom-right cell; the explicit rows
  # still size the container.
  list [gridbox p] [gridbox g]
} -result {{50 40 100 80} {0 0 100 80}}

tcltest::test modern-18.3 {row span stretches over spanned auto rows} -body {
  .h reset
  .h style {
    body { margin: 0; padding: 0; }
    div { margin: 0; }
    #g { display: grid; grid-template-columns: repeat(2, 1fr);
         width: 200px; }
    #sp { grid-row: span 2; }
    .r { height: 18px; }
  }
  .h parse -final {<body><div id="g">
    <div id="sp">sp</div><div class="r" id="q1">q1</div>
    <div class="r" id="q2">q2</div></div></body>}
  # sp occupies rows 1-2 of column 1 and stretches to their total
  # height (18 + 18); q1/q2 auto-place into column 2.
  list [gridbox sp] [gridbox q1] [gridbox q2]
} -result {{0 0 100 36} {100 0 200 18} {100 18 200 36}}

tcltest::test modern-18.4 {percentage tracks and align-self} -body {
  .h reset
  .h style {
    body { margin: 0; padding: 0; }
    div { margin: 0; }
    #g { display: grid; grid-template-columns: 25% 75%;
         grid-template-rows: 60px; width: 400px; }
    .c { height: 20px; }
    #m { align-self: center; }
    #e { align-self: flex-end; }
  }
  .h parse -final {<body><div id="g">
    <div class="c" id="m">m</div><div class="c" id="e">e</div>
    </div></body>}
  # 100px + 300px columns; center = (60-20)/2 = 20, end = 40
  list [gridbox m] [gridbox e]
} -result {{0 20 100 40} {100 40 400 60}}

tcltest::test modern-18.5 {inline-grid shrink-to-fit uses track maximums} -body {
  .h reset
  .h style {
    body { margin: 0; padding: 0; }
    div { margin: 0; }
    #wrap { width: 500px; }
    #g { display: inline-grid;
         grid-template-columns: 40px 60px; gap: 5px; }
    .c { height: 10px; }
  }
  .h parse -final {<body><div id="wrap">
    <div id="g"><div class="c">a</div><div class="c">b</div></div>
    </div></body>}
  # The inline-grid is sized by the min/max probe:
  # 40 + 5 + 60 = 105 wide
  set bb [gridbox g]
  list [expr {[lindex $bb 2] - [lindex $bb 0]}] \
       [expr {[lindex $bb 3] - [lindex $bb 1]}]
} -result {105 10}

tcltest::test modern-18.6 {no template: one auto column stacks like blocks} -body {
  .h reset
  .h style {
    body { margin: 0; padding: 0; }
    div { margin: 0; }
    #g { display: grid; width: 300px; }
    .c { height: 25px; }
  }
  .h parse -final {<body><div id="g">
    <div class="c" id="x1">x</div><div class="c" id="x2">y</div>
    </div></body>}
  # Each item gets its own implicit row; the single auto column
  # stretches to the full container width (css-grid 12.6).
  list [gridbox x1] [gridbox x2]
} -result {{0 0 300 25} {0 25 300 50}}

tcltest::test modern-18.7 {text-only grid falls back to normal flow} -body {
  .h reset
  .h style {
    body { margin: 0; padding: 0; }
    #g { display: grid; grid-template-columns: 1fr 1fr; width: 100px; }
  }
  .h parse -final {<body><div id="g">plain text</div></body>}
  # No element children: the container renders its text via the
  # normal-flow fallback (same contract as flexbox).
  expr {[lindex [gridbox g] 3] > 0}
} -result {1}

finish_test
